{
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(git --version)",
      "Bash(node bin/controlla.mjs:*)",
      "Bash(node bin/costruisci.mjs:*)",
      "Bash(node bin/sincronizza.mjs --stato)",
      "Bash(node bin/lib/chiavi.mjs --verifica:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/hooks/avvio.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/hooks/instrada.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/hooks/dopo-modifica.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/bin/hooks/proteggi.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
